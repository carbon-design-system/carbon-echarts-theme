{
  "name": "@carbon/echarts-theme-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root for @carbon/echarts-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon-echarts-theme.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "test": "pnpm -r --filter='./packages/*' test",
    "dev": "pnpm -r --filter='./packages/*' --parallel dev",
    "typecheck": "pnpm -r --filter='./packages/*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
