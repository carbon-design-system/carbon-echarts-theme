{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "changelog-type": "default",
  "separate-pull-requests": false,
  "pull-request-title-pattern": "chore${scope}: release carbon-echarts-theme",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "packages": {
    "packages/theme": {
      "package-name": "@carbon/echarts-theme",
      "component": "theme",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/toolbar": {
      "package-name": "@carbon/echarts-toolbar",
      "component": "toolbar",
      "changelog-path": "CHANGELOG.md",
      "bootstrap-sha": "f9c85b5b285300d0dbf2e35aed9f76831c5ee5a5",
      "initial-version": "0.1.0"
    }
  }
}
